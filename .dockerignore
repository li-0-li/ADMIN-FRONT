# ============================================================
# .dockerignore 作用：告诉 Docker 在 COPY 时忽略哪些文件
# 目的：减小构建上下文、加快构建、避免污染镜像
# ============================================================

# 本机安装的依赖，不需要复制进镜像（容器里会重新 npm install）
node_modules

# 本机打包产物，不需要复制进镜像（容器里会重新 npm run build）
dist

# Git 相关文件，不需要进镜像
.git
.gitignore

# 本机保存的镜像 tar 包，不需要进镜像
*.tar

# 日志和临时文件
*.log
npm-debug.log*

# 编辑器配置
.vscode
.idea

# 本机环境变量文件，含密码，不进镜像
.env
.env.local
